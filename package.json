{
  "name": "@substrate-system/fflate",
  "type": "module",
  "version": "0.9.1",
  "description": "High performance (de)compression in an 8kB package",
  "main": "./dist/node/index.js",
  "module": "./dist/browser/index.js",
  "types": "./dist/browser/index.d.ts",
  "unpkg": "./dist/umd/fflate.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "default": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      }
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./node/min": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.min.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./min": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.min.js"
    },
    "./umd": "./dist/umd/fflate.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint \"./**/*.{ts,js}\"",
    "build": "tsx scripts/build.ts",
    "build-example": "vite build --base=\"/fflate/\"",
    "build-docs": "typedoc --plugin typedoc-plugin-markdown --hideBreadcrumbs --readme none --disableSources --excludePrivate --excludeProtected --expandParameters --githubPages false --cleanOutputDir false --out docs/ src/index.ts",
    "gh-pages": "tsx scripts/cpGHPages.ts",
    "start": "vite",
    "test": "npm run build && npm run test:node && npm run test:browser",
    "test:node": "tsx test/index.ts",
    "test:valid": "tsx test/0-valid.ts",
    "test:browser": "esbuild test/browser/index.ts --bundle | tapout --timeout 30000",
    "toc": "markdown-toc --maxdepth 3 -i README.md",
    "preversion": "npm run lint",
    "version": "npm run toc && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && git add CHANGELOG.md README.md",
    "postversion": "git push --follow-tags && npm publish",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@substrate-system/tapout": "^0.0.41",
    "@substrate-system/tapzero": "^0.10.13",
    "@types/node": "^25.8.0",
    "@types/pako": "*",
    "auto-changelog": "^2.5.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "jszip": "^3.10.1",
    "markdown-toc": "^1.2.0",
    "newneostandard": "^0.14.2",
    "pako": "*",
    "preact": "^10.25.4",
    "simple-git": "^3.19.1",
    "terser": "^5.47.1",
    "tiny-inflate": "*",
    "tsx": "^4.19.3",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "uzip": "*",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "repository": "https://github.com/mycelial-systems/fflate",
  "bugs": {
    "url": "https://github.com/mycelial-systems/fflate/issues"
  },
  "keywords": [
    "gzip",
    "gunzip",
    "deflate",
    "inflate",
    "compression",
    "decompression",
    "zlib",
    "pako",
    "jszip",
    "browser",
    "node.js",
    "tiny",
    "fast",
    "zip",
    "unzip",
    "non-blocking"
  ],
  "author": "Arjun Barrett <arjunbarrett@gmail.com>",
  "license": "MIT"
}
